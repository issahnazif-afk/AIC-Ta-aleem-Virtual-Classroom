[
 {
  "key": "51645921fc41",
  "parts": [
   {
    "text": "Alhamdu lillaah!"
   }
  ]
 },
 {
  "key": "d6747d06318e",
  "parts": [
   {
    "text": "Maashaa Allah, Yusuf! Moving something harmful out of the way is a charity."
   }
  ]
 },
 {
  "key": "8b134bc45a28",
  "parts": [
   {
    "text": "May Allah bless you, my kind children."
   }
  ]
 },
 {
  "key": "c06a201e6776",
  "parts": [
   {
    "text": "See how it drinks? A little sip, then another. Let’s learn one aayah each day."
   }
  ]
 },
 {
  "key": "70637ec2e42d",
  "parts": [
   {
    "text": "Every star is Allah’s. Shall we say Subhaan Allah for them?"
   }
  ]
 },
 {
  "key": "c36aada1bd8e",
  "parts": [
   {
    "text": "First, she needs a drink."
   }
  ]
 },
 {
  "key": "3c40aebe1403",
  "parts": [
   {
    "text": "Look low, just where the sun went down,"
   }
  ]
 },
 {
  "key": "b584e578b5c8",
  "parts": [
   {
    "text": "The new moon is as thin as a fingernail."
   }
  ]
 },
 {
  "key": "70040e9a87eb",
  "parts": [
   {
    "text": "Ramadan Mubarak!"
   }
  ]
 },
 {
  "key": "6616e3032245",
  "parts": [
   {
    "text": "The Prophet, peace and blessings be upon him, said when an animal eats from what you plant, it counts as charity."
   }
  ]
 },
 {
  "key": "2d03cbd8c36e",
  "parts": [
   {
    "text": "That’s the best medicine yet!"
   }
  ]
 },
 {
  "key": "168a62418798",
  "parts": [
   {
    "text": "Football next week?"
   }
  ]
 },
 {
  "key": "0a2a8128dcfc",
  "parts": [
   {
    "text": "Allah made the moon,"
   }
  ]
 },
 {
  "key": "179e26d7f369",
  "parts": [
   {
    "text": "And every star too."
   }
  ]
 },
 {
  "key": "d131b20643e8",
  "parts": [
   {
    "text": "Allah made you too."
   }
  ]
 }
]