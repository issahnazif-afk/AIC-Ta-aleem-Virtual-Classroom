---
// The adults' home: one "Continue" for the last place read, the ways to practise as a ruled list, the riwāyah,
// and the adult's most recent saved ayah in the arch. Everything shown comes from this device's own reading
// (ql-last-read, ql-bookmarks) and the library's data; nothing is invented.
import Base from '../../../quran/layouts/Base.astro';
import { u, site } from '../../../quran/lib/url.mjs';
import { getMeta } from '../../../quran/lib/data.mjs';
import { RIWAYAT } from '../../../quran/lib/riwayat/course.mjs';
const riwayat = [{ id: 'hafs', name: 'Ḥafṣ ʿan ʿĀṣim' }, ...(getMeta().riwayat ?? []).map((r) => ({ id: r.id, name: r.name }))];
const classrooms = { hafs: { short: '', href: u('riwayat/') }, ...Object.fromEntries(Object.entries(RIWAYAT).map(([id, c]) => [id, { short: c.short, href: u(`riwayat/?rw=${id}`) }])) };
const ways = [
  { title: 'Mushaf', text: 'Read page by page, in the riwāyah you choose', href: u('page/1/?app=1') },
  { title: 'Listen', text: 'Choose a reciter and follow word by word', href: u('page/1/?app=1&listen=1') },
  { title: 'Recite to the Sheikh', text: 'He follows every word and helps only when you stop', href: u('practice/?app=1') },
  { title: 'Hifz test', text: 'The Sheikh starts an ayah; you carry on from memory', href: u('test/?app=1') },
  { title: 'Learn tajweed', text: 'The rules one by one, by the way of ash-Shāṭibiyyah', href: u('tajweed/?app=1') },
];
---
<Base title="Home" active="home">
  <style is:global>
    html[data-app] .appbar { display: none; }
    html[data-app] body:has(.lib-home) { padding-bottom: 24px !important; }
    .lib-home { max-width: 1280px; margin: 0 auto; padding: 48px 24px 24px; }
    .lib-top { display: none; align-items: center; gap: 6px; padding: 0 0 20px; }
    html[data-app] .lib-top { display: flex; }
    html[data-app] .lib-home { padding-top: calc(16px + env(safe-area-inset-top, 0px)); }
    .lib-top .brand { margin-right: auto; text-decoration: none; display: flex; align-items: center; gap: 10px; }
    .lib-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 56px; align-items: start; }
    .lib-main { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
    .lib-kicker { margin: 0 0 10px; font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-text); }
    .lib-hi { margin: 0; font-size: clamp(34px, 4.4vw, 52px); line-height: 1.08; }
    .lib-hi em { font-weight: 500; color: var(--gold-text); }
    .lib-lede { margin: 12px 0 0; font-size: 17px; line-height: 1.6; color: var(--muted); max-width: 560px; }
    .lib-label { margin: 0; font-family: var(--font-ui); font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
    :root[data-theme="dark"] .lib-label { color: var(--muted); }

    .lib-cont { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-surface); padding: 24px 28px; display: flex; flex-direction: column; gap: 16px; }
    .lib-cont-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
    .lib-cont h2 { margin: 0; font-size: 30px; }
    .lib-cont .meta { margin: 6px 0 0; font-size: 15px; color: var(--muted); }
    .lib-cont .ar { font-family: var(--font-ar-ui); font-size: 34px; line-height: 1; color: var(--accent-strong); }
    :root[data-theme="dark"] .lib-cont .ar { color: var(--ink); }
    .lib-bar { height: 6px; border-radius: 3px; background: var(--accent-soft); overflow: hidden; }
    .lib-bar span { display: block; height: 100%; width: 2%; background: var(--accent); transition: width .25s; }
    .lib-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .lib-actions .btn { min-height: 48px; padding: 0 22px; font-size: 15px; }

    .lib-ways { display: flex; flex-direction: column; }
    .lib-ways .lib-label { margin-bottom: 6px; }
    .lib-way { display: grid; grid-template-columns: 44px minmax(140px, 220px) 1fr 20px; align-items: center; gap: 16px; padding: 14px 4px; border-top: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: background-color .15s; }
    .lib-way:last-child { border-bottom: 1px solid var(--line); }
    .lib-way:hover { background: var(--accent-soft); color: var(--ink); }
    .lib-way .n { font-family: var(--font-head); font-size: 22px; color: var(--gold); }
    .lib-way b { font-size: 16px; color: var(--accent-strong); }
    :root[data-theme="dark"] .lib-way b { color: var(--ink); }
    .lib-way .t { font-size: 15px; color: var(--muted); }
    .lib-way i { font-style: normal; color: var(--accent); transition: transform .15s; }
    .lib-way:hover i { transform: translateX(3px); }

    .lib-rw { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
    .lib-rw label { display: inline-flex; align-items: center; gap: 12px; }
    .lib-rw select { height: 44px; border: 1px solid var(--field); border-radius: var(--r-control); background: var(--surface); color: var(--ink); font: inherit; font-weight: 600; padding: 0 12px; max-width: 100%; }
    .lib-rw a { font-weight: 700; font-size: 14px; }
    .lib-rw small { flex-basis: 100%; color: var(--muted); font-size: 13px; }

    .lib-side { display: flex; flex-direction: column; gap: 24px; }
    .lib-arch { background: #173D32; border-radius: 240px 240px var(--r-panel) var(--r-panel); padding: 14px; }
    .lib-arch-in { border: 1px solid #B99A5B; border-radius: 226px 226px 10px 10px; padding: 88px 36px 32px; min-height: 440px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; color: #F7F4EA; }
    .lib-arch .lab { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #DCC48E; }
    .lib-arch .ayah-ar { margin: 4px 0 0; font-family: 'KFGQPC Hafs', var(--font-quran); font-size: clamp(26px, 2.6vw, 34px); line-height: 2; color: #F7F4EA; direction: rtl; }
    .lib-arch .ayah-tr { margin: 0; font-family: var(--font-head); font-style: italic; font-size: 18px; line-height: 1.5; color: rgba(247,244,234,.88); }
    .lib-arch .ref { margin: 0; font-size: 13px; color: rgba(247,244,234,.78); }
    .lib-arch .row { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
    .lib-arch .row .btn { min-height: 48px; padding: 0 20px; }
    .lib-arch .btn.b-light { background: #F7F4EA; border-color: #F7F4EA; color: #173D32; }
    .lib-arch .btn.b-light:hover { background: #FFFFFF; color: #173D32; }
    .lib-arch .btn.b-line { background: transparent; border-color: rgba(220,196,142,.6); color: #F7F4EA; }
    .lib-arch .b-line:hover { border-color: #DCC48E; color: #F7F4EA; }
    .lib-arch :focus-visible { outline-color: #DCC48E; }
    .lib-figs { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .lib-figs div { padding: 16px 0 16px 20px; }
    .lib-figs div:first-child { padding-left: 0; }
    .lib-figs div + div { border-left: 1px solid var(--line); }
    .lib-figs dt { font-size: 12px; font-weight: 700; color: var(--muted); }
    .lib-figs dd { margin: 4px 0 0; font-family: var(--font-head); font-size: 28px; color: var(--accent-strong); }
    :root[data-theme="dark"] .lib-figs dd { color: var(--ink); }
    .lib-more { display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 14px; font-weight: 600; }

    @media (prefers-reduced-motion: reduce) { .lib-way, .lib-way i, .lib-bar span { transition: none; } }
    @media (max-width: 980px) {
      .lib-grid { grid-template-columns: 1fr; gap: 36px; }
      .lib-side { max-width: 520px; width: 100%; margin: 0 auto; }
    }
    @media (max-width: 600px) {
      .lib-home { padding: 28px 16px 16px; }
      .lib-cont { padding: 20px; }
      .lib-cont .ar { display: none; }
      .lib-cont h2 { font-size: 26px; }
      .lib-actions .btn { flex: 1 1 100%; }
      .lib-way { grid-template-columns: 34px 1fr 16px; gap: 2px 12px; }
      .lib-way .t { grid-column: 2; grid-row: 2; font-size: 14px; }
      .lib-way .n { grid-row: 1 / span 2; }
      .lib-way i { grid-column: 3; grid-row: 1 / span 2; }
      .lib-arch { border-radius: 180px 180px var(--r-panel) var(--r-panel); }
      .lib-arch-in { border-radius: 168px 168px 10px 10px; padding: 64px 20px 24px; min-height: 0; }
      .lib-figs dd { font-size: 22px; }
      .lib-figs div { padding-left: 12px; }
    }
  </style>

  <div class="lib-home">
    <div class="lib-top">
      <a class="brand" href={u('app/')}><img class="brand-logo" src={site('img/taaleem-logo.webp')} alt="" width="38" height="40" /><span class="brand-text"><b>Ta'aleem</b><small>QURAN LIBRARY</small></span></a>
      <a class="icon-btn" href={u('search/')} aria-label="Search the Quran"><svg class="svg-ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg></a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark theme"><svg class="svg-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg></button>
      <button class="icon-btn" type="button" id="home-out" aria-label="Sign out"><svg class="svg-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"></path></svg></button>
    </div>

    <div class="lib-grid">
      <section class="lib-main" aria-labelledby="lib-hi">
        <div>
          <p class="lib-kicker" id="lib-date"></p>
          <h1 class="lib-hi" id="lib-hi">Assalamu alaikum<span id="lib-name-wrap" hidden>, <em id="lib-name"></em></span></h1>
          <p class="lib-lede">Pick up where you left off, or choose how you would like to spend time with the Qur'an today.</p>
        </div>

        <div class="lib-cont">
          <p class="lib-label" id="cont-label">Start reading</p>
          <div class="lib-cont-row">
            <div>
              <h2 id="cont-title">Sūrat al-Fātiḥah</h2>
              <p class="meta" id="cont-meta">Ayah 1 of 7 · Page 1 · Juz 1</p>
            </div>
            <span class="ar" lang="ar" dir="rtl" id="cont-ar">الفاتحة</span>
          </div>
          <div class="lib-bar" role="progressbar" aria-labelledby="cont-title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="cont-bar"><span></span></div>
          <div class="lib-actions">
            <a class="btn btn-primary" id="cont-go" href={u('page/1/?app=1')}>Resume reading <span aria-hidden="true">→</span></a>
            <a class="btn" href={u('practice/?app=1')}>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
              Recite it to the Sheikh</a>
          </div>
        </div>

        <nav class="lib-ways" aria-labelledby="ways-h">
          <h2 class="lib-label" id="ways-h">Ways to practise</h2>
          {ways.map((w, i) => (
            <a class="lib-way" href={w.href} data-way={i}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><b>{w.title}</b><span class="t">{w.text}</span><i aria-hidden="true">→</i></a>
          ))}
        </nav>

        <div class="lib-rw" id="home-rw-box" data-classrooms={JSON.stringify(classrooms)}>
          <label><span class="lib-label">Riwāyah</span>
            <select id="home-rw">
              {riwayat.map((r) => <option value={r.id}>{r.name}</option>)}
            </select>
          </label>
          <a id="home-learn" href="#" hidden></a>
          <small id="home-rw-note" hidden></small>
        </div>
      </section>

      <aside class="lib-side" aria-label="Your reading">
        <div class="lib-arch">
          <div class="lib-arch-in">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#DCC48E" stroke-width="1.2" aria-hidden="true"><rect x="8" y="8" width="24" height="24"></rect><rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)"></rect><circle cx="20" cy="20" r="4"></circle></svg>
            <p class="lab" id="arch-lab">Where you are reading</p>
            <p class="ayah-ar" lang="ar" id="arch-ar"></p>
            <p class="ayah-tr" id="arch-tr"></p>
            <p class="ref" id="arch-ref"></p>
            <div class="row">
              <button class="btn b-light" type="button" id="arch-play" aria-pressed="false">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"></path></svg><span>Listen</span></button>
              <a class="btn b-line" id="arch-open" href={u('page/1/?app=1')}>Open in mushaf</a>
            </div>
          </div>
        </div>
        <dl class="lib-figs">
          <div><dt>Saved ayahs</dt><dd id="fig-saved">0</dd></div>
          <div><dt>Juz</dt><dd id="fig-juz">1</dd></div>
          <div><dt>Page</dt><dd id="fig-page">1</dd></div>
        </dl>
        <nav class="lib-more" aria-label="More">
          <a href={u('saved/')}>Saved ayahs</a>
          <a href={u('search/')}>Search</a>
          <a href={u('letters/')}>Arabic letters</a>
          <a href={u('resources/')}>Resources</a>
          <a href={u('')}>Browse the Quran</a>
          <a href={u('about/')}>About &amp; sources</a>
        </nav>
      </aside>
    </div>
  </div>

  <script>
    import { lastRead, bookmarks, settings, getJson, pad, audioUrl } from '../../../quran/lib/client.mjs';
    import { u } from '../../../quran/lib/url.mjs';
    import { me, signOut } from '../../../quran/lib/account.mjs';
    const $ = (id) => document.getElementById(id);

    // greeting and today's date (with the Hijri date where the browser knows it)
    const who = me();
    if (who) { $('lib-name').textContent = who.name.split(' ')[0]; $('lib-name-wrap').hidden = false; }
    const now = new Date();
    let date = now.toLocaleDateString('en-GB', { weekday: 'long' });
    try { date += ' · ' + new Intl.DateTimeFormat('en-GB-u-ca-islamic-umalqura', { day: 'numeric', month: 'long', year: 'numeric' }).format(now).replace(/\s*AH$/, '') + ' AH'; } catch {}
    $('lib-date').textContent = date;
    $('home-out').addEventListener('click', async (e) => { e.currentTarget.disabled = true; await signOut(); location.assign(u('signin/')); });

    // the riwāyah: the same setting as the Quran menu's, so the Mushaf and Recite open in it
    const rwSel = $('home-rw');
    const classrooms = JSON.parse($('home-rw-box').dataset.classrooms || '{}');
    const rwGet = () => { try { const v = JSON.parse(localStorage.getItem('ql-riwayah') || '"hafs"'); return [...rwSel.options].some((o) => o.value === v) ? v : 'hafs'; } catch { return 'hafs'; } };
    function showRw() {
      const v = rwSel.value, c = classrooms[v];
      const learn = $('home-learn'), note = $('home-rw-note');
      learn.hidden = !c;
      if (c) { learn.href = c.href; learn.textContent = v === 'hafs' ? 'Learn the other riwāyāt with the Sheikh →' : `Learn ${c.short} with the Sheikh →`; }
      note.hidden = v === 'hafs';
      note.textContent = v === 'qumbul' ? 'The Mushaf, Recite and the Hifz test follow this riwāyah. No recitation of Qunbul is openly available yet, so Listen has no audio.' : 'Everything follows this riwāyah: the Mushaf, Listen, Recite and the Hifz test.';
      document.documentElement.dataset.riwayah = v;
    }
    rwSel.value = rwGet();
    showRw();
    rwSel.addEventListener('change', () => { try { localStorage.setItem('ql-riwayah', JSON.stringify(rwSel.value)); } catch {} showRw(); });

    // Continue: the last place read on this device
    const lr = lastRead.get();
    const pos = lr ?? { s: 1, a: 1 };
    (async () => {
      const sura = await getJson(`surah/${pad(pos.s)}.json`).catch(() => null);
      if (!sura) return;
      const ay = sura.ayahs[pos.a - 1] ?? sura.ayahs[0];
      const total = sura.ayahs.length;
      const pct = Math.round((ay.a / total) * 100);
      $('cont-label').textContent = lr ? 'Continue reading' : 'Start reading';
      $('cont-title').textContent = `Sūrat ${sura.en}`;
      $('cont-ar').textContent = sura.ar;
      $('cont-meta').textContent = `Ayah ${ay.a} of ${total} · Page ${ay.page} · Juz ${ay.juz}`;
      $('cont-bar').setAttribute('aria-valuenow', String(pct));
      $('cont-bar').firstElementChild.style.width = Math.max(pct, 2) + '%';
      $('fig-juz').textContent = ay.juz;
      $('fig-page').textContent = ay.page;
      const k = `${pos.s}:${ay.a}`;
      const hrefs = [u(`page/${ay.page}/?app=1&k=${k}`), u(`page/${ay.page}/?app=1&listen=1&k=${k}`)];
      $('cont-go').href = hrefs[0];
      document.querySelectorAll('[data-way]').forEach((a, i) => { if (hrefs[i]) a.href = hrefs[i]; });
    })();

    // the arch: the most recent saved ayah, or else the place being read, quoted from the library's data
    const saved = bookmarks.all();
    $('fig-saved').textContent = saved.length;
    const [ks, ka] = (saved[0] ?? `${pos.s}:${pos.a}`).split(':').map(Number);
    let clip = null;
    (async () => {
      const sura = await getJson(`surah/${pad(ks)}.json`).catch(() => null);
      const ay = sura?.ayahs[ka - 1];
      if (!ay) return;
      $('arch-lab').textContent = saved.length ? 'From your saved ayahs' : 'Where you are reading';
      $('arch-ar').textContent = ay.ar;
      const tr = ay.tr?.[settings.translation] ?? Object.values(ay.tr ?? {})[0] ?? '';
      $('arch-tr').textContent = tr;
      $('arch-ref').textContent = `${sura.en} ${ks}:${ka}` + (tr ? ' · Sahih International' : '');
      $('arch-open').href = u(`page/${ay.page}/?app=1&k=${ks}:${ka}`);
    })();
    const playBtn = $('arch-play');
    const setPlay = (on) => { playBtn.setAttribute('aria-pressed', String(on)); playBtn.querySelector('span').textContent = on ? 'Pause' : 'Listen'; };
    playBtn.addEventListener('click', () => {
      if (clip && !clip.paused) { clip.pause(); setPlay(false); return; }
      clip = clip ?? new Audio(audioUrl(settings.reciter, ks, ka));
      clip.onended = () => setPlay(false);
      clip.play().then(() => setPlay(true)).catch(() => {});
    });
  </script>
</Base>
