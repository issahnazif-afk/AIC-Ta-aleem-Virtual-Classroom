---
// The warsh classroom moved into the riwāyah classroom (src/pages/quran/riwayat/): old links land there.
import { u } from '../../../quran/lib/url.mjs';
const to = u('riwayat/?rw=warsh');
---
<html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={to} /><title>Riwāyah classroom</title></head>
<body><script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script><a href={to}>Open the riwāyah classroom</a></body></html>
