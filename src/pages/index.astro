      choice.mode = 'reading'; noCam = false;
      show('s-check'); startCheck();
    }

    // ── the games ──
    function setGameSheikh(state, ar, en) {
      const sh = document.querySelector('#s-game .sheikh'); if (sh) sh.dataset.state = state;
      $('g-bubble').textContent = ar || '';
      $('g-bubble').title = en || '';
    }
    function gameUi(finished = endGame) {
      return {
        sheikh: setGameSheikh,
        feedback: (t, kind) => { const f = $('g-feedback'); f.textContent = t; f.className = 'g-feedback ' + (kind || ''); },
        timer: (t) => { const bar = $('g-timer'); bar.hidden = !t; if (t) bar.firstElementChild.style.width = `${(t.left / t.total) * 100}%`; },
        status: (st) => {
          if (st.showScore) { $('g-pts').textContent = st.score.toLocaleString(); $('g-streak').textContent = `×${st.streak}`; }
          else { const d = $('g-dots'); d.replaceChildren(...Array.from({ length: st.rounds }, (_, i) => { const x = document.createElement('i'); x.className = i < st.first ? 'on' : i < st.round - 1 ? 'miss' : ''; return x; })); }
        },
        mic: () => {},
        finished: (r) => finished(r),
      };
    }
    // Lesson 2: hear an opening, find it. Lesson 3: a letter's shape, find the letter. Lesson 8: speeds. Lesson 12: stopping.
    function mosaicQuestions(L) {
      if (L.n === 2) {
        const all = examples(L)[0].items;
        return all.map((x) => ({ prompt: { ref: x.ref }, ask: 'Which opening did the Sheikh recite?', answer: x.ref, label: `${x.ar} · ${x.note}`,
          choices: all.map((y) => ({ show: y.ar, key: y.ref })) }));
      }
      if (L.n === 3) {
        return shuffle(LETTERS).map((x) => {
          const pos = shuffle(['start', 'middle', 'end'])[0];
          const near = [...lookalikes(x.letter), ...shuffle(LETTERS.map((y) => y.letter))].filter((l, i, a) => l !== x.letter && a.indexOf(l) === i);
          return { prompt: { ar: forms(x)[pos], text: { start: 'at the beginning of a word', middle: 'in the middle of a word', end: 'at the end of a word' }[pos] },
            ask: 'Which letter is this?', answer: x.letter, label: `${x.latin} ${forms(x)[pos]}`, say: letterSpoken(x),
            choices: [x.letter, ...near.slice(0, 7)].map((l) => ({ show: l, key: l })) };
        });
      }
      if (L.n === 8) {
        const qs = [];
        SPEEDS.rows.forEach((r) => SPEEDS.cols.forEach((c, k) => {
          const vals = [...new Set(SPEEDS.rows.flatMap((x) => x.slice(1)))];
          qs.push({ prompt: { text: `${r[0]} in ${c}` }, ask: 'How long is it held?', answer: r[k + 1], label: `${r[0]}, ${c}: ${r[k + 1]}`, choices: vals.map((v) => ({ show: v, key: v })) });
        }));
        return qs;
      }
      return STOPS.map((x) => ({ prompt: { ar: x.written }, ask: 'How is it read when you stop on it?', answer: x.stop, label: x.rule, hint: x.rule,
        choices: [x.stop, ...x.wrong].map((v) => ({ show: v, key: v })) }));
    }
    function startLessonGame(n) {
      stopGame(); stopSound();
      const L = LESSONS[n - 1];
      if (L.game === 'surahs') { openLesson(n); return; }
      gameLesson = n; playCtx = null;
      $('g-home').textContent = 'Back to my garden'; $('g-recite').hidden = true;
      const lv = me.level || 1, cfg = LEVEL_GAME[lv];
      $('g-name').textContent = GAMES[L.game].name;
      $('g-sub').textContent = `Lesson ${n} · ${L.name} · ${me.className || 'Level 1'}`;
      $('g-end').hidden = true; $('g-feedback').textContent = '';
      $('g-score').hidden = !cfg.score; $('g-dots').hidden = cfg.score;
      $('g-best').textContent = String(n === 1 ? progress.best ?? 0 : progress.lessons?.[n]?.bestScore ?? 0);
      $('g-hear').hidden = L.game === 'pearls';
