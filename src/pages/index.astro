        const go = document.createElement('span'); go.className = 'act-go'; go.setAttribute('aria-hidden', 'true');
        b.append(ic, ar, t, d, go);
        if (a.suggested?.includes(me.level)) { const sg = document.createElement('span'); sg.className = 'act-tag'; sg.textContent = 'Suggested for your level'; b.append(sg); }
        if (a.kind === 'soon') b.disabled = true;
        else b.addEventListener('click', () => openActivity(a));
