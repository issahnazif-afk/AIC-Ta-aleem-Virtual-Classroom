        board.append(grid);
      } else if (L.board === 'forms') {
        const t = el('div', 'ltable forms');
        t.append(...['Alone', 'Beginning', 'Middle', 'End'].map((h) => el('span', 'lth', h)));
        for (const x of LETTERS) {
          const f = forms(x);
          for (const k of ['alone', 'start', 'middle', 'end']) { const it = { ...x, show: f[k], pos: k }; t.append(card(it, { ar: f[k], cls: 'form' })); first.push(it); }
        }
        board.append(t);
      } else if (L.board === 'syllables') {
        const HEAD = { a: 'Fat-ha', i: 'Kes-ra', u: 'Dom-ma', an: 'Two fat-ha', in: 'Two kes-ra', un: 'Two dom-ma', aa: 'Alif madd', ii: 'Ya madd', uu: 'Waw madd', sk: 'Sukun', sh: 'Shadda' };
        const t = el('div', 'ltable syl'); t.style.setProperty('--cols', L.vowels.length);
        t.append(...L.vowels.map((v) => el('span', 'lth', HEAD[v])));
        for (const x of LETTERS) for (const v of L.vowels) { const it = { ...syllable(x, v), L: x, v }; t.append(card(it, { ar: it.ar, sub: it.latin })); first.push(it); }
        board.append(t);
      } else if (L.board === 'examples') {
