        for (const x of STOPS) { const it = { ...x }; t.append(card(it, { ar: x.written }), card(it, { ar: x.stop, cls: 'stop' }), el('span', 'ltd why', x.rule)); first.push(it); }
        board.append(t);
      } else if (L.board === 'duas') {
        for (const d of DUAS) {
          const box = el('div', 'dua');
          box.append(el('h3', 'lgroup', d.name + (d.fromQuran ? ` · Qur’an ${d.ref}` : '')));
          const lines = el('div', 'dua-lines'); lines.dir = 'rtl'; lines.lang = 'ar';
          d.lines.forEach((ln) => lines.append(el('p', null, ln)));
          box.append(lines);
          if (d.fromQuran) { const h = el('button', 'btn', 'Hear the ayah'); h.type = 'button'; h.addEventListener('click', () => playAyah(d.ref, reciter())); box.append(h); }
          board.append(box);
        }
        board.append(el('p', 'muted small', 'Rabbana atina and Rabbanaghfir li are ayahs of the Qur’an and play the reciter. Learn the other supplications with your teacher, who can also add recordings of them.'));
      } else if (L.board === 'surahs') {
