    function statBoxes(stats) { return stats.map(([k, v]) => { const d = document.createElement('div'); const a = document.createElement('small'); a.textContent = k; const b = document.createElement('b'); b.textContent = v; d.append(a, b); return d; }); }
    async function endGame(r) {
      stopAmbience();
      const n = gameLesson, L = LESSONS[n - 1];
      const pr = phrase(r.accuracy >= 95 ? 'mumtaz' : r.accuracy >= 80 ? 'jayyid' : 'ahsant', me.gender);
      $('g-praise').textContent = pr.ar;
      let grewNow = false, gardenText = '';
      if (n === 1) {
        const before = progress.lessonGrown;
        if (r.grown) progress.lessonGrown = true;
        grewNow = r.grown && !before;
        $('g-end-h').textContent = `${r.first} of ${r.rounds} lanterns lit first time`;
        const stats = [['Letters known', `${r.known} of 28`], ['Time', `${r.minutes} min`]];
        if (r.score != null) stats.unshift(['Score', r.score.toLocaleString()], ['Your best', String(r.best ?? r.score)]);
        $('g-stats').replaceChildren(...statBoxes(stats));
        gardenText = r.grown ? (before ? 'Your Lesson 1 palm is fully grown. Keep its lanterns bright.' : 'Masha’Allah! You know all 28 letters. Your first date palm has grown in your garden.') : `Your Lesson 1 sprout is growing: you have lit ${r.lit} of the 28 letters and know ${r.known}. Light each letter right the first time, twice, to know it.`;
      } else {
        progress.lessons ??= {};
        const p = progress.lessons[n] ??= { played: 0, best: 0 };
        const before = !!p.grown;
        p.played++; p.best = Math.max(p.best, r.accuracy);
        if (r.score != null) p.bestScore = Math.max(p.bestScore ?? 0, r.score);
        if (r.accuracy >= 80) p.grown = true;
