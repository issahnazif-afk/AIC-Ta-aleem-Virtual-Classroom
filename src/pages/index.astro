    const PALM = '<svg viewBox="0 0 60 64" width="54" height="58" aria-hidden="true"><ellipse cx="30" cy="58" rx="20" ry="4" fill="#B9A27A"/><path d="M28 58 Q27 40 30 24 L32 24 Q31 40 33 58 Z" fill="#8A5A12"/><g fill="#2E8B57"><path d="M31 24 Q16 14 6 22 Q18 18 31 26 Z"/><path d="M31 24 Q46 14 56 22 Q44 18 31 26 Z"/><path d="M31 24 Q22 6 12 6 Q24 12 30 25 Z"/><path d="M31 24 Q40 6 50 6 Q38 12 32 25 Z"/><path d="M31 24 Q31 6 31 2 Q33 12 32 25 Z"/></g><g fill="#C9A24A"><circle cx="27" cy="28" r="2.4"/><circle cx="34" cy="28" r="2.4"/><circle cx="30.5" cy="31" r="2.4"/></g></svg>';
    const SPROUT = '<svg viewBox="0 0 60 64" width="54" height="58" aria-hidden="true"><ellipse cx="30" cy="58" rx="20" ry="4" fill="#B9A27A"/><path d="M30 58 V40" stroke="#2E8B57" stroke-width="3"/><path d="M30 44 Q18 36 16 28 Q28 30 30 44 Z" fill="#5CB85C"/><path d="M30 42 Q42 34 44 26 Q32 28 30 42 Z" fill="#5CB85C"/></svg>';
    const SEED = '<svg viewBox="0 0 60 64" width="54" height="58" aria-hidden="true"><ellipse cx="30" cy="56" rx="20" ry="6" fill="#C8B48C"/><ellipse cx="30" cy="52" rx="4" ry="3" fill="#8A6B3A"/></svg>';

    // a lesson's palm grows when its game is won with 80% right first time (Lesson 1: all 28 letters known;
    // Lesson 18: three short surahs recited to the Sheikh)
    function lessonStatus(n) {
      if (n === 1) { const st = lessonState(progress); return st.grown ? 'grown' : st.started ? 'growing' : 'seed'; }
      if (n === 18) { const k = (progress.surahs ?? []).length; return k >= 3 ? 'grown' : k ? 'growing' : 'seed'; }
