      for (let i = 0; i < trees; i++) { const x = 760 + (i % 6) * 70, y = 330 + Math.floor(i / 6) * 40; svg += `<g transform="translate(${x} ${y})"><rect x="-4" y="0" width="8" height="40" fill="#6E4A22"/><circle cy="-10" r="28" fill="#3E8E5A"/><circle cx="-14" cy="0" r="18" fill="#357A4D"/><circle cx="14" cy="-2" r="18" fill="#4BA36A"/></g>`; }
      for (let i = 0; i < flowers; i++) { const x = 40 + rnd(i + 1) * 1120, y = 440 + rnd(i + 50) * 60; svg += `<g transform="translate(${x.toFixed(0)} ${y.toFixed(0)})"><path d="M0 0 V-16" stroke="#5CB85C" stroke-width="2"/><g fill="${['#FBE3A6', '#F4B6C2', '#FFFFFF', '#C9B6F4'][i % 4]}"><circle cy="-20" r="5"/><circle cx="-5" cy="-16" r="5"/><circle cx="5" cy="-16" r="5"/></g><circle cy="-17" r="3" fill="#C29F4B"/></g>`; }
