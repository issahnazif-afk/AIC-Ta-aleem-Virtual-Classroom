    function startPlay(ctx) {
      stopGame(); stopSound();
      playCtx = ctx;
      const { a } = ctx, lv = me.level || 1, cfg = LEVEL_GAME[lv];
      $('g-name').textContent = a.title;
      $('g-sub').textContent = (ctx.surah ? `Surah ${ctx.surah.en} · ` : ctx.topic ? `${ctx.topic} · ` : '') + (me.className || 'Level 1');
      $('g-end').hidden = true; $('g-feedback').textContent = '';
      $('g-score').hidden = true; $('g-dots').hidden = false;
      $('g-hear').hidden = !['detective', 'ayah'].includes(a.game);
      $('g-home').textContent = 'Back to my Classroom';
      $('g-recite').hidden = true;
      $('s-game').dataset.level = String(lv); $('s-game').dataset.game = a.game;
      show('s-game');
      if (!isMuted()) startAmbience();
      const common = { stage: $('g-stage'), level: lv, gender: me.gender, ui: gameUi(endPlay), reciter: reciter() };
      if (a.game === 'detective') game = createDetective({ ...common, progress });
      else if (a.game === 'ayah') game = createBuildAyah({ ...common, surah: ctx.surah });
      else if (a.game === 'match') game = createMatch({ ...common, pairs: questions({ game: 'match', kind: 'pair', topic: ctx.topic, level: lv }) });
      else if (a.game === 'journey') game = createJourney({ ...common, items: questions({ game: 'journey', level: lv }) });
