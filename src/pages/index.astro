        big.textContent = it.ar; big.classList.toggle('long', it.ar.length > 6);
        said.textContent = ''; lat.textContent = `${surahName(+it.ref.split(':')[0]).en} ${it.ref}`; note.textContent = it.note;
        hear.textContent = 'Hear the ayah';
