          <h2 class="h2 accent-ink">The Sheikh's review</h2>
          <p id="r-review" class="r-review"></p>
        </div>
        <div class="card">
          <h2 class="h2">Ayah by ayah</h2>
          <div id="r-strip" class="strip"></div>
        </div>
      </div>
      <aside class="r-side">
        <div class="card earned" id="r-earned" hidden></div>
        <div class="card sent" id="r-sent" data-state="sending">
          <span class="sent-ic" aria-hidden="true"></span>
          <div>
            <h2 class="h2" id="r-sent-h">Sending to your teacher…</h2>
            <p class="muted small" id="r-sent-t"></p>
            <button class="btn" type="button" id="r-retry" hidden>Try again</button>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script>
    import { configure, isDemo, login, register, listClasses, setGender, sendSession, flushOutbox } from '../lib/classlog.mjs';
    import { phrase, praiseFor, speak } from '../lib/phrases.mjs';
    import { getProgress, saveProgress, logGame } from '../lib/classlog.mjs';
    import { LETTERS, LEVEL_GAME, levelNumber, lessonState, MASTERED, lookalikes } from '../lib/alifba.mjs';
    import { createLanterns } from '../lib/lanterns.mjs';
    import { LESSONS, GAMES, SPEEDS, STOPS, DUAS, SURAHS, examples, forms, syllable, syllableItems, basketsFor } from '../lib/lessons.mjs';
    import { createRain, createMosaic, createBaskets, createPearls, playAyah, shuffle } from '../lib/games.mjs';
    import { LETTER_VOICES, letterVoice, setLetterVoice, letterSpoken, sayLetter, say, playUrl, stopSound } from '../lib/voice.mjs';
    import { audioUrl, getJson } from '../lib/client.mjs';
    import { createDetective, createBuildAyah, createMatch, createJourney, createSalah, createAkhlaq, AYAH_SURAHS, PLACES } from '../lib/play.mjs';
    import { loadBank, questions, topics, isPreview } from '../lib/questions.mjs';
    import { BADGES, record, deedDone, rewardsOf, todaysMissions } from '../lib/rewards.mjs';
    import { mountStudio } from '../lib/studio.mjs';
    import { loadStudio } from '../lib/voice.mjs';
    import { startAmbience, stopAmbience, setMuted, isMuted, nasheed } from '../lib/ambience.mjs';
    import { openCamera, micMeter, snapshot, testTone } from '../lib/media.mjs';
    import { createGazeWatcher, loadGaze } from '../lib/gaze.mjs';
    import { getSpeechRecognition, prepareFastListening, preloadQaaf } from '../lib/speech.mjs';
    import { forLevel, ICONS, WORLDS } from '../lib/activities.mjs';
    import { makhrajOf, makhrajSvg } from '../lib/makhraj.mjs';
    import { STORIES as LEVEL1_STORIES } from '../lib/stories/level1.mjs';
    import { mountShelf, openStory } from '../lib/stories/reader.mjs';
    import { mountLibrary, openBook, noteRead } from '../lib/library/library.mjs';
    import { THEMES } from '../lib/themes.mjs';
    import { EPISODES as SQ_EPISODES, LATER as SQ_LATER } from '../lib/seerah/episodes.mjs';
    import { createEngine } from '../lib/engine.mjs';
    import { LEVELS, CATEGORIES, gradeOf, mistakesTotal, topMistakes, review, newSessionId } from '../lib/session.mjs';
    import { store } from '../lib/client.mjs';
    import { mountKidsHome } from '../lib/kids-home.mjs';
    import { u as siteUrl } from '../lib/url.mjs';
    import { sunnahOfDay } from '../lib/deen/sunnah.mjs';
    import { hijri, hijriText, specialOn } from '../lib/deen/days.mjs';

    const $ = (id) => document.getElementById(id);
    const body = document.body;
    configure(body.dataset.logUrl);
    const localAsr = body.dataset.localAsr === '1';
    if (isDemo()) $('demo-note').hidden = false;
    loadStudio();   // the teachers' Voice Studio recordings, if any
    function openStudio() {
      if (isDemo()) { $('demo-note').hidden = false; $('demo-note').textContent = 'The Voice Studio needs the class log to be connected (CLASS_LOG_URL).'; return; }
      show('s-studio');
      mountStudio($('studio'), { onExit: () => { if (location.hash === '#studio') history.replaceState(null, '', location.pathname + location.search); show('s-signin'); } });
    }
    $('open-studio').addEventListener('click', openStudio);
    if (location.hash === '#studio') setTimeout(openStudio, 0);
    flushOutbox().catch(() => {});
    setInterval(() => flushOutbox().catch(() => {}), 60000);

    // ── state ────────────────────────────────────────────────
    const me = { name: '', username: '', gender: '', classCode: '', className: '', token: '', loginTime: null, level: 1 };
    let stream = null, meter = null, watcher = null, snap = '';
    let noCam = false;   // Recite (no camera): microphone only, straight to the setup
    let choice = { mode: 'hifz', level: 'intermediate', ...store.get('choice', {}) };
    let engine = null, sessionStart = 0, timerT = 0;

    function show(id) {
      document.querySelectorAll('.screen').forEach((s) => (s.hidden = s.id !== id));
      window.scrollTo(0, 0);
    }

    // ── 1 · sign in ──────────────────────────────────────────
    const USER_RE = /^[a-z0-9][a-z0-9._-]{2,23}$/;
    function setTab(which) {
      const up = which === 'new';
      $('tab-in').setAttribute('aria-selected', String(!up)); $('tab-new').setAttribute('aria-selected', String(up));
      $('signin').hidden = up; $('signup').hidden = !up;
      (up ? $('up-name') : $('in-user')).focus();
      if (up) loadClasses();
    }
    $('tab-in').addEventListener('click', () => setTab('in'));
    // the level doors: remember the level, and choose it in "Create account"
    document.querySelectorAll('[data-door]').forEach((d) => d.addEventListener('click', async () => {
      const n = d.dataset.door;
      document.querySelectorAll('[data-door]').forEach((x) => x.setAttribute('aria-pressed', String(x === d)));
      store.set('door', n);
      $('door-msg').textContent = `Level ${n}: sign in below. New here? Choose Create account, and your teacher will give you the Level ${n} class password.`;
      if (!$('signup').hidden) { await loadClasses(); pickDoorClass(); }
      (window.matchMedia('(max-width: 900px)').matches ? $('tab-in') : $('in-user')).scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
    function pickDoorClass() {
      const n = store.get('door', ''); if (!n) return;
      const o = [...$('up-class').options].find((x) => /\d/.test(x.textContent) && levelNumber(x.textContent) === Number(n));
      if (o) $('up-class').value = o.value;
    }
    $('tab-new').addEventListener('click', () => setTab('new'));
    let classesLoaded = false;
    async function loadClasses() {
      if (classesLoaded) return;
      const r = await listClasses();
      const sel = $('up-class');
      if (!r.ok) { sel.replaceChildren(new Option('Could not load the levels', '')); $('up-err').textContent = r.message; return; }
      classesLoaded = true;
      sel.replaceChildren(new Option('Choose your level', ''), ...r.classes.map((c) => new Option(c.name, c.code)));
      pickDoorClass();
    }
    const saved = store.get('who', null);
    if (saved?.username) $('in-user').value = saved.username;
    else if (!saved) setTimeout(() => setTab('new'), 0);

    function signedIn(r) {
      Object.assign(me, { name: r.name, username: r.username, gender: r.gender || '', classCode: r.classCode, className: r.className, token: r.token, loginTime: new Date() });
      if (!me.gender) {   // accounts made before gender was asked: ask once
        $('signin').hidden = true; $('signup').hidden = true; $('ask-gender').hidden = false;
        document.querySelector('.si-tabs').hidden = true;
        return;
      }
      store.set('who', { username: r.username });
      document.querySelectorAll('[data-name]').forEach((x) => (x.textContent = me.name.split(' ')[0]));
      $('in-pass').value = ''; $('up-pass').value = ''; $('up-pass2').value = ''; $('up-cpass').value = '';
      goHome(true);
    }
    function busy(btn, on, label) { btn.disabled = on; btn.textContent = on ? 'Please wait…' : label; }

    $('signin').addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = $('in-user').value.trim().toLowerCase();
      const password = $('in-pass').value;
      $('in-err').textContent = '';
      if (!username) return fail('in-err', 'Enter your username.', 'in-user');
      if (!password) return fail('in-err', 'Enter your password.', 'in-pass');
      busy($('in-go'), true);
      const r = await login({ username, password });
      busy($('in-go'), false, 'Sign in');
      if (!r.ok) return fail('in-err', r.message, 'in-pass');
      signedIn(r);
    });

    $('signup').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $('up-name').value.trim().replace(/\s+/g, ' ');
      const classCode = $('up-class').value;
      const classPassword = $('up-cpass').value;
      const username = $('up-user').value.trim().toLowerCase();
      const password = $('up-pass').value;
      $('up-err').textContent = '';
      if (name.length < 3) return fail('up-err', 'Enter your full name.', 'up-name');
      const gender = document.querySelector('input[name="up-g"]:checked')?.value || '';
      if (!gender) return fail('up-err', 'Choose Boy or Girl.');
      if (!classCode) return fail('up-err', 'Choose your level.', 'up-class');
      if (!classPassword && !isDemo()) return fail('up-err', 'Enter your level’s class password from your teacher.', 'up-cpass');
      if (!USER_RE.test(username)) return fail('up-err', 'Usernames are 3 to 24 letters or numbers, and may use . _ or - (no spaces).', 'up-user');
      if (password.length < 6) return fail('up-err', 'Choose a password of at least 6 characters.', 'up-pass');
      if (password !== $('up-pass2').value) return fail('up-err', 'The two passwords are not the same.', 'up-pass2');
      busy($('up-go'), true);
      const r = await register({ name, gender, classCode, classPassword, username, password });
      busy($('up-go'), false, 'Create account');
      if (!r.ok) return fail('up-err', r.message, r.error === 'username-taken' || r.error === 'bad-username' ? 'up-user' : r.error === 'wrong-class-password' ? 'up-cpass' : null);
      signedIn(r);
    });
    $('ask-gender').addEventListener('submit', async (e) => {
      e.preventDefault();
      const g = document.querySelector('input[name="ask-g"]:checked')?.value;
      if (!g) return fail('ask-err', 'Choose Boy or Girl.');
      busy($('ask-go'), true);
      const r = await setGender({ token: me.token, gender: g });
      busy($('ask-go'), false, 'Continue');
      if (!r.ok) return fail('ask-err', r.message);
      $('ask-gender').hidden = true; document.querySelector('.si-tabs').hidden = false; $('signin').hidden = false;
      signedIn({ ...me, gender: g });
    });
    function fail(where, msg, focus) { $(where).textContent = msg; if (focus) $(focus).focus(); }

    // ── 2 · camera, microphone, snapshot, face ───────────────
    function setCheck(id, ok, text) {
      const c = $(id);
      c.dataset.ok = ok === true ? 'yes' : ok === false ? 'no' : 'wait';
      if (text) c.querySelector('[data-t]').textContent = text;
    }
    async function startCheck() {
      $('ck-err').textContent = '';
      setCheck('ck-cam', null, 'Starting…'); setCheck('ck-mic', null); setCheck('ck-spk', null); setCheck('ck-face', null, 'Loading face check…');
      checkFast();
      try {
        stream ??= await openCamera();
      } catch (err) {
        setCheck('ck-cam', false, 'Camera or microphone blocked');
        $('cam-off').hidden = false;
        $('cam-off').textContent = 'Allow the camera and microphone for this site (the icon in the address bar), then press Try again.';
        $('ck-err').textContent = 'The classroom needs your camera and microphone.';
        $('to-setup').disabled = false; $('to-setup').textContent = 'Try again';
        $('to-setup').onclick = () => { $('to-setup').onclick = null; $('to-setup').textContent = 'Continue'; startCheck(); };
        return;
      }
      $('cam-off').hidden = true;
      const v = $('cam');
      v.srcObject = stream;
      await v.play().catch(() => {});
      const vt = stream?.getVideoTracks()[0];
      $('cam-name').textContent = vt?.label || 'Camera';
      setCheck('ck-cam', true, 'Camera is on');
      meter?.stop();
      let heard = false;
      const bars = [...$('meter').children];
      meter = micMeter(stream, (lv) => {
        const n = Math.round(lv * bars.length);
        bars.forEach((b, i) => b.classList.toggle('on', i < n));
        if (lv > 0.25 && !heard) { heard = true; setCheck('ck-mic', true, 'We can hear you'); }
      });
      $('to-setup').disabled = false;
      $('retake').disabled = false;
      // face check: loads the model, then waits for a face and records the neutral pose
      let snapped = false;
      const takeSnap = () => { snap = snapshot(v); $('snap').src = snap; $('snap').hidden = false; $('snap-ph').hidden = true; $('snap-title').textContent = `Login snapshot taken · ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`; snapped = true; };
      const fallback = setTimeout(() => { if (!snapped) takeSnap(); }, 6000);
      try {
        await loadGaze();
        watcher?.stop();
        watcher = createGazeWatcher(v, {
          onFrame: (m) => {
            if (!m || snapped) return;
            clearTimeout(fallback);
            takeSnap();
          },
        });
        await watcher.start();
        setCheck('ck-face', null, 'Look at the screen for a moment…');
        const c = await watcher.calibrate({ need: 12, maxMs: 9000 });
        if (c.ok) setCheck('ck-face', true, 'Face visible and facing the screen');
        else setCheck('ck-face', false, 'Face not found. Sit in front of the camera with good light.');
        watcher.stop();
      } catch (err) {
        console.warn('face check unavailable', err);
        watcher = null;
        setCheck('ck-face', false, 'Face check could not load. Hifz tests will run without it.');
      }
    }
    $('retake').addEventListener('click', () => { const v = $('cam'); if (v.readyState >= 2) { snap = snapshot(v); $('snap').src = snap; $('snap-title').textContent = `Login snapshot taken · ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`; } });
    $('tone').addEventListener('click', () => { testTone(); setCheck('ck-spk', true, 'Did you hear a tone? If not, check your volume.'); });
    $('ck-back').addEventListener('click', () => { stopMedia(); if (reciteLesson) { reciteLesson = null; openLesson(18); } else goHome(); });
    const FAST = { ready: [true, 'On-device, words appear quickly'], downloading: [null, 'Downloading the Arabic speech pack (one time)…'], downloadable: [null, 'The Arabic speech pack downloads when you continue'], unavailable: [false, 'Online listening (this computer has no on-device Arabic)'], unsupported: [false, 'Online listening (use Chrome for the fastest tracking)'] };
    const fastStatus = (st) => { const [ok, t] = FAST[st] ?? FAST.unsupported; setCheck('ck-fast', ok, t); };
    function checkFast() { if (localAsr) { preloadQaaf(); setCheck('ck-fast', true, 'The Qāf speech model, on this computer'); return; } prepareFastListening({ onStatus: fastStatus }); }
    $('to-setup').addEventListener('click', () => {
      if (!localAsr) prepareFastListening({ install: true, onStatus: fastStatus });   // needs this click to start the one-time download
      if (!stream) return;
      if (!snap && $('cam').readyState >= 2) { snap = snapshot($('cam')); }
      show('s-setup');
      if (reciteLesson) {   // Alif Ba, Lesson 18: open on the chosen short surah
        fromSel.value = toSel.value = String(reciteLesson.surah);
        $('su-a1').value = '1'; $('su-a2').value = String(reciteLesson.ayahs);
      }
      syncSetup();
    });
    function stopMedia() { meter?.stop(); meter = null; watcher?.stop(); stream?.getTracks().forEach((t) => t.stop()); stream = null; }

    // ── 3 · setup ────────────────────────────────────────────
    const fromSel = $('su-from'), toSel = $('su-to');
    const range = store.get('range', { s1: 67, a1: 1, s2: 67, a2: 30 });
    fromSel.value = String(range.s1); toSel.value = String(range.s2);
    $('su-a1').value = String(range.a1); $('su-a2').value = String(range.a2);
    $('su-voice').value = store.get('voice', body.dataset.defaultReciter);
    const maxAyah = (sel) => Number(sel.selectedOptions[0].dataset.ayahs);
    fromSel.addEventListener('change', () => { $('su-a1').value = '1'; $('su-a1').max = String(maxAyah(fromSel)); if (Number(toSel.value) < Number(fromSel.value)) { toSel.value = fromSel.value; toSel.dispatchEvent(new Event('change')); } syncSetup(); });
    toSel.addEventListener('change', () => { $('su-a2').value = String(maxAyah(toSel)); $('su-a2').max = String(maxAyah(toSel)); syncSetup(); });
    ['su-a1', 'su-a2', 'su-q'].forEach((id) => $(id).addEventListener('input', syncSetup));
    document.querySelectorAll('[data-level]').forEach((b) => b.addEventListener('click', () => { choice.level = b.dataset.level; syncSetup(); }));
    function syncSetup() {
      document.querySelectorAll('[data-level]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.level === choice.level)));
      document.querySelectorAll('#s-setup [data-hifz-only]').forEach((x) => (x.hidden = choice.mode !== 'hifz'));
      const hifz = choice.mode === 'hifz';
      $('su-h').textContent = hifz ? 'Hifz test' : noCam ? 'Recite · no camera' : 'Mujawwadah · reading from the mushaf';
      $('start').textContent = hifz ? 'Start Hifz test' : 'Open the mushaf';
      const s1 = fromSel.selectedOptions[0].textContent.replace(/^\d+\.\s*/, ''), s2 = toSel.selectedOptions[0].textContent.replace(/^\d+\.\s*/, '');
      const r = s1 === s2 ? `${s1} ${$('su-a1').value}–${$('su-a2').value}` : `${s1} ${$('su-a1').value} to ${s2} ${$('su-a2').value}`;
      $('su-sum').textContent = `${hifz ? 'Hifz test' : noCam ? 'Recite' : 'Mujawwadah'} · ${LEVELS[choice.level].name} · ${r}`;
    }
    $('su-back').addEventListener('click', () => { if (noCam) { noCam = false; goHome(); } else show('s-check'); });
    $('start').addEventListener('click', startSession);

    // ── 4 · the classroom ────────────────────────────────────
    const sheikhEl = () => document.querySelector('#sheikh-tile .sheikh');
    const SHEIKH_TAGS = { speaking: 'Sheikh · reciting', listening: 'Sheikh · listening', prompt: 'Sheikh · prompting you', stop: 'Sheikh · stopped you', idle: 'Sheikh' };
    function setSheikh(state, ar, en) {
      sheikhEl().dataset.state = state;
      $('sheikh-tile').dataset.state = state;
      $('sheikh-tag').textContent = SHEIKH_TAGS[state] ?? 'Sheikh';
      if (ar !== undefined) $('say-ar').textContent = ar;
      if (en !== undefined) $('say-en').textContent = en;
    }
    const NOTE_TEXT = {
      wrong: (n) => `Wrong word${n.heard ? ` (heard “${n.heard}”)` : ''}`,
      prompt: () => 'Forgotten word · the Sheikh prompted',
      hint: () => 'Hint used',
      unclear: () => 'Unclear · recite it clearly next time',
      back: () => 'Went back over words',
      away: () => 'Looked away from the screen',
    };
    let notesN = 0;
    function addNote(n) {
      notesN++;
      $('notes-n').textContent = `${notesN} so far`;
      $('c-notes-n').textContent = String(notesN);
      const li = document.createElement('li');
      li.className = 'note k-' + n.kind;
      const dot = document.createElement('i'); dot.className = 'dot';
      const box = document.createElement('div');
      const t = document.createElement('p'); t.textContent = NOTE_TEXT[n.kind]?.(n) ?? n.kind;
      const s = document.createElement('p'); s.className = 'muted small';
      if (n.label) { s.append(n.label.replace(/^.*?(\d+:\d+)$/, 'Ayah $1')); if (n.word && n.kind !== 'away') { const w = document.createElement('span'); w.className = 'nw'; w.lang = 'ar'; w.textContent = n.word; s.append(' · ', w); } }
      box.append(t, s);
      li.append(dot, box);
      $('notes').prepend(li);
    }
    function setStatus(text, kind) { const st = $('status'); st.textContent = text; st.className = 'status' + (kind ? ' ' + kind : ''); }
    function tickTimer() { const s = Math.floor((Date.now() - sessionStart) / 1000); $('c-timer').textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`; }

    let awayAt = 0;
    function onGaze(state, why) {
      if (!engine || engine.mode !== 'hifz') return;
      const self = $('self-tile');
      self.dataset.state = state;
      $('self-label').textContent = state === 'ok' ? 'You · face visible' : state === 'noface' ? 'You · face not visible' : 'You · looking away';
      if (state === 'ok') return;
      if (!['answer', 'sheikh'].includes(engine.phase)) return;
      if (engine.pause('away')) {
        awayAt = Date.now();
        $('away-why').textContent = state === 'noface' ? 'Your face is not visible to the camera.' : `It looked like you were ${why || 'looking away'}.`;
        $('away').hidden = false;
        $('s-class').dataset.away = '1';
        { const p = phrase('lookatme', me.gender); setSheikh('stop', p.ar, 'Look at the screen, then continue.'); }
        setStatus('Paused. Look at the Sheikh, then press “I’m ready, continue”.', 'bad');
      }
    }
    $('away-resume').addEventListener('click', () => {
      if (watcher && watcher.state !== 'ok') { setStatus('Look at the screen first, then press continue.', 'bad'); return; }
      $('away').hidden = true;
      delete $('s-class').dataset.away;
      if (awayAt) { engine.addAwayTime(Date.now() - awayAt); awayAt = 0; }
      engine.resume();
    });

    async function startSession() {
      $('su-err').textContent = '';
      const { SR, engine: asr } = getSpeechRecognition({ localAsr, track: true });
      if (!SR) { $('su-err').textContent = 'This browser cannot check speech. Open the classroom in Chrome or Edge.'; return; }
      const s1 = Number(fromSel.value), s2 = Number(toSel.value);
      const a1 = Math.max(1, parseInt($('su-a1').value, 10) || 1);
      const a2 = Math.max(1, parseInt($('su-a2').value, 10) || maxAyah(toSel));
      if (s1 > s2 || (s1 === s2 && a1 > a2)) { $('su-err').textContent = 'The end of the range must come after its start.'; return; }
      store.set('range', { s1, a1, s2, a2 }); store.set('choice', choice); store.set('voice', $('su-voice').value);
      meter?.stop(); meter = null;
      stream?.getAudioTracks().forEach((t) => t.stop());   // the speech engine opens the microphone itself

      const hifz = choice.mode === 'hifz';
      $('s-class').dataset.mode = choice.mode;
      document.querySelectorAll('#s-class [data-hifz-only]').forEach((x) => (x.hidden = !hifz));
      document.querySelectorAll('#s-class [data-reading-only]').forEach((x) => (x.hidden = hifz));
      $('c-title').textContent = hifz ? 'Hifz test' : noCam ? 'Recite · no camera' : 'Mujawwadah · reading from the mushaf';
      $('s-class').toggleAttribute('data-nocam', noCam);
      $('c-level').textContent = LEVELS[choice.level].name;
      $('notes').replaceChildren(); notesN = 0; $('notes-n').textContent = 'None yet'; $('c-notes-n').textContent = '';
      $('where').textContent = ''; setStatus('', ''); $('stage').replaceChildren(); $('c-sub').textContent = '';
      $('away').hidden = true; delete $('s-class').dataset.away;
      $('cam2').srcObject = stream; $('cam2').play().catch(() => {});
      $('self-tile').dataset.state = 'ok'; $('self-label').textContent = 'You · live';
      show('s-class');
      setSheikh('idle', '', '');
      sessionStart = Date.now(); clearInterval(timerT); timerT = setInterval(tickTimer, 1000); tickTimer();

      engine = createEngine({
        stage: $('stage'), SR, level: choice.level, reciter: $('su-voice').value, gender: me.gender,
        ui: {
          sheikh: setSheikh, status: setStatus, note: addNote,
          where: (w) => { $('where').textContent = w.label; },
          mic: (on) => { $('mic').setAttribute('aria-pressed', String(on)); $('mic-t').textContent = on ? 'Listening' : 'Microphone'; },
          progress: ({ qi, n, mode }) => {
