        $('g-end-h').textContent = `${r.first} of ${r.rounds} right first time`;
        const stats = [['Right first time', `${r.accuracy}%`], ['Your best', `${p.best}%`], ['Time', `${r.minutes} min`]];
        if (r.score != null) stats.unshift(['Score', r.score.toLocaleString()]);
        $('g-stats').replaceChildren(...statBoxes(stats));
        gardenText = grewNow ? `Masha’Allah! Your Lesson ${n} palm has grown in your garden.` : p.grown ? `Your Lesson ${n} palm is grown. Play again to keep it strong.` : `Your Lesson ${n} sprout is growing. Get 80% right first time to grow its palm.`;
      }
      $('g-garden').textContent = gardenText;
      $('g-practise').textContent = r.practise.length ? `Practise these: ${r.practise.join('  ')}` : '';
