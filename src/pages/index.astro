        const sp = letterSpoken(it);
        big.textContent = it.show; said.textContent = it.letter; lat.textContent = `${it.latin} · ${{ alone: 'on its own', start: 'at the beginning', middle: 'in the middle', end: 'at the end' }[it.pos]}`;
        hear.textContent = 'Hear the letter';
