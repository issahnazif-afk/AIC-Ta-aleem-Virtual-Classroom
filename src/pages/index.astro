      $('ls-play').disabled = L.game === 'surahs';
      $('ls-stars').textContent = lessonSummary(L.n);
      const board = $('ls-board'); board.replaceChildren(); board.dataset.kind = L.board;
      const first = [];
      if (L.board === 'letters') {
        const grid = el('div', 'lgrid letters'); grid.dir = 'rtl';
        for (const x of LETTERS) {
