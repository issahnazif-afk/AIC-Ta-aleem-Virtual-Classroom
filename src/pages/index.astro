    function renderLesson() {
      const L = LESSONS[selLesson - 1];
      $('ls-crumb').textContent = `Classroom · Alif Ba · Lesson ${L.n}`;
      $('ls-num').textContent = `Lesson ${L.n} of ${LESSONS.length}`;
