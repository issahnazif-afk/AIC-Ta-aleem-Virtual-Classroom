      send();
    }
    async function send() {
      const card = $('r-sent');
      card.dataset.state = 'sending';
      $('r-sent-h').textContent = 'Sending to your teacher…'; $('r-sent-t').textContent = ''; $('r-retry').hidden = true;
      const r = await sendSession(lastEntry);
      const at = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (r.ok && r.demo) { card.dataset.state = 'demo'; $('r-sent-h').textContent = 'Not saved (demo mode)'; $('r-sent-t').textContent = 'The class log is not connected yet. See apps-script/README.md.'; }
      else if (r.ok) { card.dataset.state = 'ok'; $('r-sent-h').textContent = 'Sent to your teacher'; $('r-sent-t').textContent = `This session was added to the ${me.className} class log at ${at}.`; }
      else if (r.queued) { card.dataset.state = 'queued'; $('r-sent-h').textContent = 'Waiting to send'; $('r-sent-t').textContent = 'The class log could not be reached. It will be sent automatically when you are back online.'; $('r-retry').hidden = false; }
