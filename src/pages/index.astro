      return p?.grown ? 'grown' : p?.played ? 'growing' : 'seed';
    }
    const reciter = () => store.get('voice', cfg0.defaultReciter) || cfg0.defaultReciter;
    const cfg0 = { defaultReciter: document.body.dataset.defaultReciter };
    // ── the Classroom home: one card per activity (src/lib/activities.mjs) ──
    async function goHome(fresh) {
      me.level = levelNumber(me.className);
      document.querySelectorAll('[data-level-pill]').forEach((x) => (x.textContent = me.className || 'Level 1'));
      document.querySelectorAll('[data-fullname]').forEach((x) => (x.textContent = me.name));
