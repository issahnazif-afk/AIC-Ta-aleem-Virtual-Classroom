        const ic = document.createElement('span'); ic.className = 'act-ic'; ic.innerHTML = ICONS[a.kind === 'soon' ? 'soon' : a.icon] ?? '';
        const ar = document.createElement('span'); ar.className = 'act-ar'; ar.lang = 'ar'; ar.dir = 'rtl'; ar.textContent = a.ar ?? '';
        const t = document.createElement('b'); t.textContent = a.title;
