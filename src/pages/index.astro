          const done = (progress.surahs ?? []).includes(n);
          grid.append(card(it, { ar: m.ar, sub: `${n}. ${m.en}`, small: `${m.ayahs} ayahs${done ? ' · recited ✓' : ''}`, cls: done ? 'known' : '' }));
          first.push(it);
        }
        board.append(grid);
      }
      if (!selItem || !first.includes(selItem)) selItem = first[0] ?? null;
      showItem(selItem, false);
      board.querySelectorAll('.lcard').forEach((c, i) => c.classList.toggle('sel', first[i] === selItem && L.board !== 'stops'));
    }
    function showMakhraj(it) {
      const m = makhrajOf(it.file);
