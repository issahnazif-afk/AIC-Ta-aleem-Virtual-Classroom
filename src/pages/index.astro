      try { $('h-hijri').textContent = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { day: 'numeric', month: 'long', year: 'numeric' }).format(now).replace(/\s*AH$/, ''); } catch { $('h-hijri').textContent = ''; }
      $('h-greg').textContent = now.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });
      for (const g of ['hifz', 'lessons', 'play']) $('acts-' + g).replaceChildren();
