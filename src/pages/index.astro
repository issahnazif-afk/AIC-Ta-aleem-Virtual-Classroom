      show('s-seerah');
    }
    async function startSeerah(n) {
      const quality = $('sq-quality').value; store.set(SQ_KEY, quality);
      const sq = (progress.seerah ??= {}), st = (sq[n] ??= {});
      show('s-seerah-play');
      const t0 = Date.now();
      const { playEpisode } = await import('../lib/seerah/quest.mjs');
      quest?.stop();
      quest = playEpisode($('sq-root'), {
        n, quality, reciter: reciter(), saved: st.done ? {} : st,
        onStep: (i) => { st.step = i; },
        onExit: async () => { quest = null; await saveProgress({ token: me.token, username: me.username, progress }); openSeerah(); },
        onDone: async ({ quiz }) => {
          const acc = quiz ? Math.round((quiz.right / quiz.of) * 100) : 100;
          st.done = true; st.step = 0; st.best = Math.max(st.best ?? 0, acc);
          quest?.stop(); quest = null;
          const ep = SQ_EPISODES.find((e) => e.n === n);
          openSeerah();
          const e = record(progress, { kind: 'seerah', key: `seerah:${n}`, score: acc, good: acc >= 66, gardenPalms: palms() });
          const box = document.createElement('div'); box.className = 'card sq-earned';
          const h = document.createElement('h2'); h.className = 'h2'; h.textContent = `Episode ${n} complete: ${ep.title}`;
          const p = document.createElement('p'); p.textContent = quiz ? `Knowledge challenge: ${quiz.right} of ${quiz.of} right first time.` : '';
          const er = document.createElement('div'); box.append(h, p, er); showEarned(er, e);
          $('sq-episodes').before(box);
          await saveProgress({ token: me.token, username: me.username, progress });
          logGame({ token: me.token, game: { game: 'The Seerah Quest', lesson: `Episode ${n}: ${ep.title}`, rounds: quiz?.of ?? '', first: quiz?.right ?? '', accuracy: acc, score: '', practise: '', known: '', minutes: Math.max(1, Math.round((Date.now() - t0) / 60000)) } });
        },
      });
    }
    addEventListener('beforeunload', (e) => { if (engine && engine.phase !== 'done') { e.preventDefault(); e.returnValue = ''; } });
  </script>
</body>
</html>
