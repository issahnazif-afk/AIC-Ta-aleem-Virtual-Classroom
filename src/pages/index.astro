      $('ls-mk-where').textContent = m.place.en.charAt(0).toUpperCase() + m.place.en.slice(1) + (m.nose ? ', and the nose' : '');
      $('ls-mk-ar').textContent = m.place.ar;
      $('ls-mk-how').textContent = m.how;
      $('ls-mk-heavy').hidden = !m.heavy;
      $('ls-mk').hidden = false;
