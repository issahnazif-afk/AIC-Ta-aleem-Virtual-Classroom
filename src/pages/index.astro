      const common = { stage: $('g-stage'), level: lv, gender: me.gender, ui: gameUi(), reciter: reciter() };
      if (L.game === 'lanterns') { const { SR } = getSpeechRecognition({ localAsr }); game = createLanterns({ ...common, SR, progress }); }
      else if (L.game === 'rain') game = createRain({ ...common, items: syllableItems(L) });
      else if (L.game === 'mosaic') game = createMosaic({ ...common, questions: mosaicQuestions(L) });
