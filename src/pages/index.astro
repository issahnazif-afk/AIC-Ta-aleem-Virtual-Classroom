    // ── Play & Learn ──
    let playCtx = null;
    function pickScreen(title, game, text, items, onPick, empty) {
      $('pk-game').textContent = game; $('pk-h').textContent = title; $('pk-text').textContent = text;
      const grid = $('pk-grid'); grid.replaceChildren();
