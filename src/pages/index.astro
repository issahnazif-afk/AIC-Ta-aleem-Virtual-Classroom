    function renderGarden() {
      $('hub-title').textContent = `${me.name.split(' ')[0]}'s Jannah Garden`;
      const grown = LESSONS.filter((L) => lessonStatus(L.n) === 'grown').length;
      $('hub-count').textContent = `${grown} of ${LESSONS.length} lessons grown`;
      const box = $('plots'); box.replaceChildren();
