        return pickScreen('Choose a surah', 'Build the Ayah', 'Choose a surah you are learning. Put its ayahs together word by word, then listen to the Sheikh.',
          AYAH_SURAHS[lv].map((n) => ({ n, ar: surahName(n).ar, label: `${n}. ${surahName(n).en}`, small: `${surahName(n).ayahs} ayahs` })),
          async (it) => { const data = await getJson(`surah/${String(it.n).padStart(3, '0')}.json`); startPlay({ a, surah: data }); }, '');
      }
      if (a.game === 'match') {
        const ts = topics('match', lv, 'pair').filter((t) => t.n >= 3);
        return pickScreen('Choose a topic', 'Match the Deen', 'Turn over two cards at a time and find the matching pairs.',
          ts.map((t) => ({ label: t.topic, small: `${t.n} pairs`, topic: t.topic })), (it) => startPlay({ a, topic: it.topic }), NOT_READY);
      }
      const need = { journey: questions({ game: 'journey', level: lv }).length >= 4, salah: questions({ game: 'salah', level: lv }).length >= 3, akhlaq: questions({ game: 'akhlaq', level: lv }).length >= 3, detective: true };
      if (!need[a.game]) return pickScreen(a.title, a.title, '', [], () => {}, NOT_READY);
      startPlay({ a });
