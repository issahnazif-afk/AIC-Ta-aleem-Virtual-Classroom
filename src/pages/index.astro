          saveProgress({ token: me.token, username: me.username, progress });
        }
        reciteLesson = null;
      }

      lastEntry = {
        token: me.token, snapshot: snap,
        session: {
          id, studentName: me.name, username: me.username, gender: me.gender, className: me.className, loginTime: me.loginTime?.toISOString(), endTime: endTime.toISOString(), minutes,
          mode: res.mode, level: LEVELS[choice.level].name, surahs: passage, ayahs: res.ayahCount,
          questions: hifz ? res.questions : '', words: t.words, rightFirstPct: t.words ? Math.round((t.first / t.words) * 100) : 0,
          grade, mistakesTotal: total, topMistakes: top.map((x) => `${x.label} ×${x.n}`).join('; '),
          wrong: t.wrong, prompts: t.prompt, hints: t.hint, unclear: t.unclear, wentBack: t.back, lookAways: hifz ? t.lookAways : '',
          review: rev,
        },
