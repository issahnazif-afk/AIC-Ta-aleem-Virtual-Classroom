      if (b.dataset.go === 'hub') { stopGame(); goHub(); }
      if (b.dataset.go === 'home') { stopGame(); stopSound(); storyBook?.stop(); storyBook = null; libBook?.stop(); libBook = null; ebook?.stop(); ebook = null; deenView?.stop(); deenView = null; goHome(); }
    }));
