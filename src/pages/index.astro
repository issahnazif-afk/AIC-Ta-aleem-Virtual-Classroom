    $('g-recite').addEventListener('click', () => { const n = playCtx?.surah?.n; stopGame(); if (n) reciteSurah({ n, ayahs: surahName(n).ayahs }); });

    // ── Ta'aleem Stars, the dashboard, My Achievements and My Jannah Garden ──
    const palms = () => LESSONS.filter((L) => lessonStatus(L.n) === 'grown').length;
    function showEarned(box, e) {
      if (!e || !e.stars) { box.hidden = true; return; }
      box.replaceChildren();
      const h = document.createElement('p'); h.className = 'earned-h'; h.textContent = `+${e.stars} Ta'aleem Star${e.stars === 1 ? '' : 's'}`;
      const ul = document.createElement('ul'); e.notes.forEach((n) => { const li = document.createElement('li'); li.textContent = n; ul.append(li); });
      box.append(h, ul);
      for (const b of e.badges) { const p = document.createElement('p'); p.className = 'earned-badge'; p.textContent = `${b.icon} New badge: ${b.name}`; box.append(p); }
      box.hidden = false;
      renderStars();
    }
    function renderStars() {
      const r = rewardsOf(progress);
      document.querySelectorAll('[data-stars]').forEach((x) => (x.textContent = `★ ${r.stars}`));
      document.querySelectorAll('[data-stars-n]').forEach((x) => (x.textContent = String(r.stars)));
      document.querySelectorAll('[data-streak]').forEach((x) => (x.textContent = String(r.streak)));
    }
    function renderMissions() {
      // the character mission is the Sunnah of the day (src/lib/deen/sunnah.mjs), the same for the whole level
      const sn = sunnahOfDay(me.level || 1);
      const deeds = [{ prompt: `Sunnah of the day: ${sn.title}. ${sn.do}` }];
      const ms = todaysMissions(progress, deeds, me.username);
