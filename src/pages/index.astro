    function showItem(it, speakIt) {
      const L = LESSONS[selLesson - 1];
      selItem = it;
      const big = $('ls-big'), said = $('ls-said'), lat = $('ls-latin'), note = $('ls-note'), hear = $('ls-hear');
      hear.hidden = false; hear.textContent = 'Hear the Sheikh'; note.textContent = '';
      $('ls-mk').hidden = true;
      $('ls-big').parentElement.hidden = false;
      if (!it) {
        big.textContent = ''; said.textContent = ''; lat.textContent = ''; big.parentElement.hidden = true; hear.hidden = true;
        if (L.board === 'speeds') lat.textContent = 'Tahqeeq · Tadweer · Hadr';
        if (L.board === 'duas') lat.textContent = 'Read each supplication with your teacher, a line at a time.';
