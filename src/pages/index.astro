    // ── 5 · report and class log ─────────────────────────────
    let lastEntry = null;
    function endSession(res) {
      clearInterval(timerT);
      watcher?.stop();
      const t = res.tally;
      const minutes = Math.max(1, Math.round((Date.now() - sessionStart) / 60000));
      const grade = gradeOf(t);
      const total = mistakesTotal(t, choice.level);
      const top = topMistakes(t);
      const passage = res.passage || '—';
      const rev = review(t, { mode: res.mode, passage, weakAyahs: res.weakAyahs });
      const hifz = res.mode === 'hifz';
      const endTime = new Date();
      const id = newSessionId(me.classCode);

      $('r-title').textContent = `Session complete, ${me.name.split(' ')[0]}`;
      { const pr = phrase(t.words ? praiseFor(t.words ? t.first / t.words : 0, t.prompt, t.hint) : 'ahsant', me.gender); $('r-praise').textContent = pr.ar; $('r-praise').hidden = !t.words; }
      const fmt = (d) => d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      $('r-sub').textContent = `${hifz ? 'Hifz test' : 'Mujawwadah'} · ${passage} · ${LEVELS[choice.level].name} · Hafs · ${endTime.toLocaleDateString([], { day: 'numeric', month: 'short', year: 'numeric' })}, ${fmt(new Date(sessionStart))} to ${fmt(endTime)}`;
      $('r-snap').src = snap || ''; $('r-snap').hidden = !snap;
      $('m-time').textContent = `${minutes} min`;
      $('m-q-l').textContent = hifz ? 'Questions' : 'Ayahs read';
      $('m-q').textContent = hifz ? String(res.questions) : String(res.ayahCount);
      $('m-mist').textContent = String(total);
      $('m-away').textContent = hifz ? `${t.lookAways} time${t.lookAways === 1 ? '' : 's'}` : '—';
      const bars = $('r-top'); bars.replaceChildren();
      const max = Math.max(1, ...top.map((x) => x.n));
      if (!top.length) { const p = document.createElement('p'); p.className = 'muted'; p.textContent = t.words ? 'No mistakes. Well done.' : 'No recitation was heard.'; bars.append(p); }
      for (const x of top) {
        const row = document.createElement('div'); row.className = 'bar';
        const l = document.createElement('span'); l.textContent = x.label;
        const tr = document.createElement('span'); tr.className = 'track'; const f = document.createElement('i'); f.style.width = `${(x.n / max) * 100}%`; tr.append(f);
        const n = document.createElement('b'); n.textContent = String(x.n);
        row.append(l, tr, n); bars.append(row);
      }
      $('r-review').textContent = rev;
      const strip = $('r-strip'); strip.replaceChildren();
      const MK = { wrong: 'wrong word', prompt: 'prompted', hint: 'hint', unclear: 'unclear', back: 'went back', away: 'looked away' };
      for (const a of res.perAyah) {
        const c = document.createElement('span');
        const bad = a.marks.some((m) => m === 'wrong' || m === 'prompt');
        c.className = 'chip ' + (bad ? 'bad' : a.marks.length ? 'warn' : 'ok');
        c.textContent = `${a.s}:${a.a}` + (a.marks.length ? ' · ' + a.marks.map((m) => MK[m]).join(', ') : '');
        strip.append(c);
      }
      if (!res.perAyah.length) { const p = document.createElement('p'); p.className = 'muted'; p.textContent = 'No ayahs were recited.'; strip.append(p); }
      show('s-report');
      if (t.words) showEarned($('r-earned'), record(progress, { kind: res.mode, key: `${res.mode}:${passage}`, score: Math.round((t.first / t.words) * 100), gardenPalms: palms() }));
      else $('r-earned').hidden = true;
      saveProgress({ token: me.token, username: me.username, progress });
      if (reciteLesson && !hifz) {   // Alif Ba, Lesson 18: a surah recited well grows the palm
        if (t.words && t.first / t.words >= 0.7) {
