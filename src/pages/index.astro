        P('duas', "My du'as", 'أَدْعِيَتِي', 'dua', '#E6F2EC', () => openDeen('duas')),
        P('sunnah', 'Sunnah of the day', 'سُنَّةُ الْيَوْمِ', 'sunnah', '#FFF4CC', () => openDeen('sunnah')),
        P('prophet', 'Our Prophet ﷺ', 'نَبِيُّنَا ﷺ', 'prophet', '#E3F0FA', () => openDeen('prophet')),
        P('stories', 'Stories', 'قِصَص', 'stories', '#FDE7EC', go('stories')),
        P('books', 'My books', 'كُتُبِي', 'books', '#E6F2EC', go('books')),
        ...(me.level >= 2 ? [P('library', 'Reading Library', 'ٱلْمَكْتَبَة', 'library', '#F1E9FB', go('library')), P('tawheed', 'Knowing Allah', 'ٱلتَّوْحِيد', 'tawheed', '#FFF9EC', go('tawheed'))] : []),
        P('quran', 'Qur’an', 'ٱلْقُرْآن', 'mushaf', '#FFFDF7', go(me.level >= 2 ? 'ayah' : 'recite'), { say: "Qur'an" }),
        P('games', 'Games', 'أَلْعَاب', 'match', '#FFE9D6', null, { children: games }),
        P('days', 'Special days', 'أَيَّامٌ مُبَارَكَة', 'calendar', '#E3E8FA', () => openDeen('days')),
        P('garden', 'My garden', 'حَدِيقَتِي', 'garden', '#DFF3DA', () => openGarden()),
