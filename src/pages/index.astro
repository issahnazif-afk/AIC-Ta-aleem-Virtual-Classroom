        const n = progress.letters?.[it.letter] ?? 0;
        note.textContent = n >= MASTERED ? 'Known, masha’Allah ★★' : n === 1 ? 'Lit once ★ · once more to know it' : 'Not lit yet';
        showMakhraj(it);
